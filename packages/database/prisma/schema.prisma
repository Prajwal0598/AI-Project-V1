generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMAIL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEB
  MANUAL
}

enum CustomerType {
  LEAD
  CUSTOMER
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum OrderStatus {
  DRAFT
  AWAITING_APPROVAL
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// tracks shipment progress independently of OrderStatus (payment/lifecycle) once an order is PAID
enum FulfillmentStatus {
  NOT_STARTED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum InventoryAlertType {
  LOW_STOCK
  OUT_OF_STOCK
}

enum InventoryAlertStatus {
  ACTIVE
  RESOLVED
}

enum StockAdjustmentReason {
  MANUAL_EDIT
  ORDER_RESERVED
  ORDER_RELEASED
  IMPORT
}

enum ProductSource {
  MANUAL
  IMPORT
}

// merchant-controlled visibility: DRAFT/HIDDEN are never shown to customers; "out of stock" is a computed
// display state (PUBLISHED product where every variant's inventory is 0), not a separate stored status
enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ImportStatus {
  PENDING
  READY_FOR_REVIEW
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

// fine-grained per-customer interest events — the raw material the opportunity engine scores/reasons over;
// deliberately separate from ActivityEvent, which is a coarse CRM timeline, not a queryable signal store
enum CustomerSignalType {
  PRODUCT_VIEWED
  PRODUCT_ENQUIRY
  BACK_IN_STOCK_WANTED
}

enum OpportunityType {
  ABANDONED_CART
  PRODUCT_ENQUIRY
  BACK_IN_STOCK
  HIGH_PURCHASE_INTENT
  REPEAT_PURCHASE
  CROSS_SELL
  UPSELL
  NEW_PRODUCT_MATCH
  PROMOTION
  UNANSWERED_CONVERSATION
  LOW_ENGAGEMENT
  HIGH_VALUE_CUSTOMER
}

enum PromotionTargetSegment {
  ALL_CUSTOMERS
  CATEGORY_BUYERS
  HIGH_VALUE_CUSTOMERS
}

enum ProductRelationType {
  CROSS_SELL
  UPSELL
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
}

// NEW: not yet actioned. SENT: merchant approved/sent the suggestion. DISMISSED/SNOOZED: merchant chose not
// to act (yet). CONVERTED: an order was attributed to it after sending. EXPIRED: went stale, never actioned.
enum OpportunityStatus {
  NEW
  SENT
  DISMISSED
  SNOOZED
  CONVERTED
  EXPIRED
}

enum ImportRowStatus {
  READY
  WARNING
  ERROR
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

// deterministic WhatsApp shopping-flow state (button/list navigation) — kept separate from the free-text AI flow
enum ShoppingState {
  IDLE
  MAIN_MENU
  BROWSING_CATEGORIES
  BROWSING_PRODUCTS
  VIEWING_PRODUCT
  AWAITING_QUANTITY
  CART_REVIEW
  COLLECTING_ADDRESS
  COLLECTING_PAYMENT
  ORDER_CONFIRMATION
}

// how a conversation ultimately resolved — for CRM/revenue reporting
enum ConversationOutcome {
  OPEN
  SALE
  SUPPORT
  ESCALATED
  LOST
  ABANDONED
}

enum ActivityEventType {
  CONVERSATION_CREATED
  MESSAGE_SENT
  ORDER_PLACED
  ORDER_UPDATED
  CUSTOMER_TAGGED
  LEAD_SCORED
}

model Business {
  id                    String         @id @default(cuid())
  name                  String
  industry              String?
  website               String?
  timezone              String         @default("Asia/Kolkata")
  whatsappPhoneNumberId String?        @unique
  instagramPageId       String?        @unique
  supportEmail          String?        @unique
  autonomyMaxOrderValue Decimal?       @db.Decimal(12, 2) // orders above this total require human approval before payment/fulfillment proceeds; null = no cap
  defaultLowStockThreshold Int         @default(5) // used by any variant without its own lowStockThreshold override
  proactiveSuggestionsEnabled Boolean  @default(false) // master switch — off by default so existing businesses see no behavior change until they opt in
  defaultRepeatPurchaseDays   Int      @default(30) // fallback reorder window used when a customer has only bought a product once (not enough history to average an interval)
  defaultLowEngagementDays    Int      @default(45) // a previously-active customer with no activity for this long is eligible for a LOW_ENGAGEMENT win-back nudge
  highValueLeadScoreThreshold Int      @default(70) // LeadScore.score at/above this marks a customer eligible for HIGH_VALUE_CUSTOMER nudges
  // per-merchant channel credentials, encrypted at rest (AES-256-GCM) — falls back to the shared .env tokens when null (single-demo-business setup)
  whatsappAccessTokenEncrypted String?
  instagramAccessTokenEncrypted String?
  postmarkServerTokenEncrypted   String?
  // Razorpay: keyId is not sensitive (safe to store plain, needed to resolve which secret to decrypt), but the
  // key secret and webhook secret are encrypted the same way as the channel tokens above
  razorpayKeyId                    String?
  razorpayKeySecretEncrypted        String?
  razorpayWebhookSecretEncrypted     String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  users         User[]
  customers     Customer[]
  identities    Identity[]
  conversations Conversation[]
  products      Product[]
  variants      Variant[]
  categories    Category[]
  carts         Cart[]
  importJobs    ImportJob[]
  orders        Order[]
  activity      ActivityEvent[]
  aiActionLogs  AiActionLog[]
  inventoryAlerts   InventoryAlert[]
  stockAdjustments  StockAdjustment[]
  customerSignals   CustomerSignal[]
  opportunities     Opportunity[]
  automationRules   AutomationRule[]
  productRelations  ProductRelation[]
  promotions        Promotion[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(OWNER)
  // grants access to the cross-business /platform admin endpoints (order/revenue totals, merchant list) —
  // unrelated to the per-business UserRole; almost never true, set manually for internal platform-operator accounts
  isPlatformAdmin Boolean @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime? // account is locked (login rejected) while this is set and in the future
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
}

// opaque, rotated-on-use refresh tokens — lets a session survive access-token expiry without a full re-login.
// tokenHash is a plain SHA-256 (not bcrypt): the raw token itself is already a high-entropy random secret,
// so a fast deterministic hash is fine here (and required, since we need an exact-match DB lookup by hash).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  type          CustomerType   @default(LEAD)
  tags          String[]       @default([])
  proactiveMessagingOptOut Boolean @default(false) // customer opted out of proactive/unsolicited AI outreach (still gets normal replies)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities    Identity[]
  conversations Conversation[]
  leadScore     LeadScore?
  orders        Order[]
  carts         Cart[]
  activity      ActivityEvent[]
  signals       CustomerSignal[]
  opportunities Opportunity[]

  @@index([businessId, updatedAt])
  @@unique([businessId, email])
  @@index([businessId, phone])
}

model Identity {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  channel     Channel
  identifier  String
  displayName String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, channel, identifier])
  @@index([customerId])
}

model Conversation {
  id            String             @id @default(cuid())
  businessId    String
  customerId    String
  identityId    String?
  channel       Channel
  title         String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  lastOrderKey  String?            // fingerprint of the last items+address+payment combo that was actually ordered — blocks re-placing the same order on a repeat/duplicate AI trigger
  activeOrderId String?            // the order this conversation can still amend/cancel (cleared once it's no longer PENDING_PAYMENT)
  escalated        Boolean         @default(false) // true once the AI has paused itself/been paused for human handoff
  escalationReason String?
  outcome          ConversationOutcome @default(OPEN)
  // deterministic WhatsApp shopping flow (button/list taps) — separate from the free-text AI flow above
  shoppingState    ShoppingState   @default(IDLE)
  activeCategoryId String?         // category currently being browsed (BROWSING_PRODUCTS)
  activeProductId  String?         // product currently being viewed (VIEWING_PRODUCT / AWAITING_QUANTITY)
  pendingVariantId String?         // variant chosen while awaiting a quantity reply
  pendingAddress   String?         // shipping address collected mid-checkout, before payment method is chosen
  pendingPaymentMethod String?     // "UPI" | "COD" | "CARD" chosen mid-checkout, before final order confirmation
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  identity      Identity?          @relation(fields: [identityId], references: [id], onDelete: SetNull)
  messages      Message[]
  orders        Order[]
  carts         Cart[]

  @@index([businessId, status, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  content           String
  providerMessageId String?          @unique
  metadata          Json?            // { source, responseId, state, model } for AI drafts
  // sentAt: when the message was sent (caller-supplied for historical imports); createdAt: DB insert time
  sentAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model LeadScore {
  id         String   @id @default(cuid())
  customerId String   @unique
  score      Int      @default(0)
  reason     String?
  calculatedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  brand       String?
  imageUrl    String?
  status      ProductStatus @default(PUBLISHED)
  source      ProductSource @default(MANUAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    Variant[]
  orderItems  OrderItem[]
  inventoryAlerts   InventoryAlert[]
  stockAdjustments  StockAdjustment[]
  customerSignals   CustomerSignal[]
  opportunities     Opportunity[]
  relationsFrom     ProductRelation[] @relation("ProductRelationsFrom")
  relationsTo       ProductRelation[] @relation("ProductRelationsTo")

  @@index([businessId, status])
  @@index([categoryId])
}

// merchant-defined product grouping for category-first WhatsApp browsing (supports one level of subcategory via parentId)
model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryChildren")
  products   Product[]

  @@index([businessId, active, sortOrder])
  @@index([parentId])
}

// a sellable unit — every Product has at least one (the "default" variant for products without size/color options)
model Variant {
  id             String   @id @default(cuid())
  businessId     String
  productId      String
  sku            String?
  barcode        String?
  attributes     Json?    // e.g. { "size": "M", "color": "Red" } — null for single-variant products
  price          Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  inventory      Int?
  lowStockThreshold Int?  // overrides Business.defaultLowStockThreshold for this specific variant; null = use the business default
  weight         Decimal? @db.Decimal(10, 3) // kg — captured now for future courier integration
  length         Decimal? @db.Decimal(10, 2) // cm
  width          Decimal? @db.Decimal(10, 2)
  height         Decimal? @db.Decimal(10, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  cartItems      CartItem[]
  inventoryAlerts   InventoryAlert[]
  stockAdjustments  StockAdjustment[]
  customerSignals   CustomerSignal[]

  @@index([businessId, active])
  @@index([productId])
  @@unique([businessId, sku])
}

// carts driving the WhatsApp interactive shopping flow through to checkout — a conversation can have many
// over time (one per shopping session), but at most one ACTIVE cart per conversation (enforced in CartService)
model Cart {
  id             String     @id @default(cuid())
  businessId     String
  conversationId String
  customerId     String
  status         CartStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  opportunities  Opportunity[]

  @@index([businessId, status])
  @@index([conversationId, status])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// one uploaded catalogue file being parsed/validated/committed into products+variants
model ImportJob {
  id            String       @id @default(cuid())
  businessId    String
  filename      String
  sourceType    String       // "CSV" | "XLSX"
  status        ImportStatus @default(PENDING)
  rowsDetected  Int          @default(0)
  rowsReady     Int          @default(0)
  rowsWarning   Int          @default(0)
  rowsError     Int          @default(0)
  columnMapping Json?        // detected source-header -> canonical-field mapping, shown/confirmed on the review screen
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rows          ImportRow[]

  @@index([businessId, createdAt])
}

// one source row (e.g. one CSV line) within an ImportJob, tracked from raw data through to commit
model ImportRow {
  id               String          @id @default(cuid())
  importJobId      String
  rowNumber        Int
  rawData          Json            // original source fields, verbatim
  normalizedData   Json?           // mapped onto the canonical product schema
  status           ImportRowStatus @default(READY)
  validationErrors Json?           // string[]
  matchedProductId String?         // set when an existing SKU match was found
  action           String?         // "CREATE" | "UPDATE" | "SKIP" — merchant's resolution for this row, defaults based on validation
  committedProductId String?       // set once this row has been committed to a real Product
  aiSuggestions    Json?           // { category?: { value, confidence }, description?: { value, confidence } } — proposed, unconfirmed until the merchant accepts one into normalizedData
  createdAt        DateTime        @default(now())
  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, status])
}

model Order {
  id          String      @id @default(cuid())
  businessId  String
  customerId  String
  conversationId String?  // the conversation this order originated from, so the worker can notify the customer when payment clears
  status      OrderStatus @default(DRAFT)
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  subtotal    Decimal     @db.Decimal(12, 2)
  shippingFee Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("INR")
  shippingAddress Json?
  paymentMethod   String?
  // real Razorpay Payment Link backing a UPI order (null if Razorpay isn't configured for this business, or
  // for COD orders) — the webhook uses razorpayPaymentLinkId to find the order to mark paid
  razorpayPaymentLinkId  String? @unique
  razorpayPaymentLinkUrl String?
  razorpayPaymentId      String? // captured Razorpay payment id, set once the webhook confirms payment
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  opportunityOutcome OpportunityOutcome?

  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ActivityEvent {
  id          String            @id @default(cuid())
  businessId  String
  customerId  String?
  type        ActivityEventType
  summary     String
  metadata    Json?
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

// records every autonomous decision the AI makes that carries real-world consequence — the audit trail
// the merchant (and support) can use to see exactly what the AI did, why, and with what outcome
model AiActionLog {
  id             String   @id @default(cuid())
  businessId     String
  customerId     String?
  conversationId String?
  orderId        String?
  action         String
  reason         String?
  result         String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// at most one ACTIVE alert per variant at a time (enforced in InventoryService, not the DB) — auto-resolved once restocked above threshold
model InventoryAlert {
  id                 String               @id @default(cuid())
  businessId         String
  productId          String
  variantId          String
  type               InventoryAlertType
  status             InventoryAlertStatus @default(ACTIVE)
  inventoryAtTrigger Int
  threshold          Int
  createdAt          DateTime             @default(now())
  resolvedAt         DateTime?
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            Variant              @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([variantId, status])
}

// full inventory audit trail — every stock-changing event, whatever the source
model StockAdjustment {
  id                String                @id @default(cuid())
  businessId        String
  productId         String
  variantId         String
  delta             Int                   // positive = stock increased, negative = decreased
  previousInventory Int?
  newInventory      Int?
  reason            StockAdjustmentReason
  note              String?
  createdById       String?               // set for MANUAL_EDIT; null for system-driven reasons
  createdAt         DateTime              @default(now())
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           Variant               @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId, variantId, createdAt])
  @@index([businessId, createdAt])
}

// raw interest events the opportunity engine reasons over (e.g. "customer viewed product X") — kept separate
// from ActivityEvent (a coarse CRM timeline) so it can be queried/scored efficiently per customer+product
model CustomerSignal {
  id         String             @id @default(cuid())
  businessId String
  customerId String
  type       CustomerSignalType
  productId  String?
  variantId  String?
  metadata   Json?
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant    Variant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([businessId, customerId, type])
  @@index([businessId, productId, type])
}

// a detected sales opportunity — surfaced in the merchant's Suggestions inbox for review/send/dismiss/snooze
model Opportunity {
  id              String              @id @default(cuid())
  businessId      String
  customerId      String
  type            OpportunityType
  priority        OpportunityPriority @default(MEDIUM)
  score           Int                 @default(0) // 0-100, deterministic — drives sort order and priority
  confidence      Float               @default(0.5) // 0-1, how sure the engine is this is a real opportunity
  reason          String              // deterministic, grounded explanation — never AI-generated, so it's always auditable
  estimatedValue  Decimal?            @db.Decimal(12, 2)
  status          OpportunityStatus   @default(NEW)
  relatedProductId String?
  relatedCartId    String?
  relatedPromotionId String?          // which broadcast Promotion this PROMOTION-type opportunity came from — without this, two different promotions to the same customer would dedup against each other (they share no relatedProductId/relatedCartId to differentiate)
  snoozedUntil    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  relatedProduct  Product?            @relation(fields: [relatedProductId], references: [id], onDelete: SetNull)
  relatedCart     Cart?               @relation(fields: [relatedCartId], references: [id], onDelete: SetNull)
  relatedPromotion Promotion?         @relation(fields: [relatedPromotionId], references: [id], onDelete: SetNull)
  suggestion      Suggestion?
  outcome         OpportunityOutcome?

  @@index([businessId, status, priority])
  @@index([businessId, customerId, type])
}

// the AI-generated recommended action for an Opportunity — kept separate so editing the message never touches
// the Opportunity's own scoring/lifecycle fields
model Suggestion {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  message       String      // the AI-drafted (or templated) customer-facing message
  editedMessage String?     // merchant's edit, if any — sent in place of `message` when present
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

// what actually happened after a suggestion was sent — the P0 slice of the doc's "Learning" loop
model OpportunityOutcome {
  id                String      @id @default(cuid())
  opportunityId     String      @unique
  sentAt            DateTime?
  orderId           String?     @unique
  attributedRevenue Decimal?    @db.Decimal(12, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  order             Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// per-business, per-opportunity-type merchant controls — governs whether an opportunity is created at all,
// whether it auto-sends or waits for approval, and simple guardrails against over-messaging
model AutomationRule {
  id                            String          @id @default(cuid())
  businessId                    String
  opportunityType               OpportunityType
  enabled                       Boolean         @default(true)
  autoSend                      Boolean         @default(false) // false = approval-first (the doc's default for every type except order/status updates)
  businessHoursStart            Int?            // hour 0-23 local to Business.timezone; null = no restriction
  businessHoursEnd              Int?            // hour 0-23; auto-send only fires within [start, end)
  frequencyCapPerCustomerPerDay Int?             // max NEW opportunities of any type created for one customer per day; null = no cap
  minConfidenceForAutoSend      Float           @default(0) // below this, auto-send is skipped even if enabled — falls back to manual review (doc: "Low-confidence suggestion -> Manual review")
  personalizedTiming            Boolean         @default(false) // when true, auto-send targets each customer's own inferred best-reply hour instead of the static business-hours window (falls back to businessHours if not enough history)
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  business                      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, opportunityType])
}

// merchant-configured "goes well with" (CROSS_SELL) or "premium alternative" (UPSELL) links between products —
// drives the CROSS_SELL/UPSELL opportunity types after an order completes; deliberately manual, not
// auto-derived from purchase-basket analysis (a much larger data-science task, out of scope here)
model ProductRelation {
  id               String              @id @default(cuid())
  businessId       String
  productId        String              // the product the customer just bought
  relatedProductId String              // the product to suggest
  type             ProductRelationType
  createdAt        DateTime            @default(now())
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product          Product             @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product             @relation("ProductRelationsTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@index([businessId, productId])
}

// merchant-authored discount/promo, broadcast to a chosen customer segment — drives the PROMOTION opportunity
// type. Deliberately NOT AI-drafted (unlike every other Suggestion message): a promo often carries specific
// terms/codes the merchant wrote themselves, so the exact text is sent as-is, never touched by the model.
model Promotion {
  id                 String                 @id @default(cuid())
  businessId         String
  title              String
  message            String                 // sent verbatim as the Suggestion message for every targeted customer
  discountDescription String?               // display-only label, e.g. "20% off" — no real coupon/code enforcement (matches the rest of this project's simulated-payment philosophy)
  targetSegment      PromotionTargetSegment
  categoryId         String?                // required when targetSegment = CATEGORY_BUYERS
  broadcastedAt      DateTime?
  broadcastCount     Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]

  @@index([businessId, createdAt])
}
