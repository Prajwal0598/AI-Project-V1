generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMAIL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEB
  MANUAL
}

enum CustomerType {
  LEAD
  CUSTOMER
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum OrderStatus {
  DRAFT
  AWAITING_APPROVAL
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// tracks shipment progress independently of OrderStatus (payment/lifecycle) once an order is PAID
enum FulfillmentStatus {
  NOT_STARTED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ProductSource {
  MANUAL
  IMPORT
}

// merchant-controlled visibility: DRAFT/HIDDEN are never shown to customers; "out of stock" is a computed
// display state (PUBLISHED product where every variant's inventory is 0), not a separate stored status
enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ImportStatus {
  PENDING
  READY_FOR_REVIEW
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  READY
  WARNING
  ERROR
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

// deterministic WhatsApp shopping-flow state (button/list navigation) — kept separate from the free-text AI flow
enum ShoppingState {
  IDLE
  MAIN_MENU
  BROWSING_CATEGORIES
  BROWSING_PRODUCTS
  VIEWING_PRODUCT
  AWAITING_QUANTITY
  CART_REVIEW
  COLLECTING_ADDRESS
  COLLECTING_PAYMENT
  ORDER_CONFIRMATION
}

// how a conversation ultimately resolved — for CRM/revenue reporting
enum ConversationOutcome {
  OPEN
  SALE
  SUPPORT
  ESCALATED
  LOST
  ABANDONED
}

enum ActivityEventType {
  CONVERSATION_CREATED
  MESSAGE_SENT
  ORDER_PLACED
  ORDER_UPDATED
  CUSTOMER_TAGGED
  LEAD_SCORED
}

model Business {
  id                    String         @id @default(cuid())
  name                  String
  industry              String?
  website               String?
  timezone              String         @default("Asia/Kolkata")
  whatsappPhoneNumberId String?        @unique
  instagramPageId       String?        @unique
  supportEmail          String?        @unique
  autonomyMaxOrderValue Decimal?       @db.Decimal(12, 2) // orders above this total require human approval before payment/fulfillment proceeds; null = no cap
  // per-merchant channel credentials, encrypted at rest (AES-256-GCM) — falls back to the shared .env tokens when null (single-demo-business setup)
  whatsappAccessTokenEncrypted String?
  instagramAccessTokenEncrypted String?
  postmarkServerTokenEncrypted   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  users         User[]
  customers     Customer[]
  identities    Identity[]
  conversations Conversation[]
  products      Product[]
  variants      Variant[]
  categories    Category[]
  carts         Cart[]
  importJobs    ImportJob[]
  orders        Order[]
  activity      ActivityEvent[]
  aiActionLogs  AiActionLog[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  type          CustomerType   @default(LEAD)
  tags          String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities    Identity[]
  conversations Conversation[]
  leadScore     LeadScore?
  orders        Order[]
  carts         Cart[]
  activity      ActivityEvent[]

  @@index([businessId, updatedAt])
  @@unique([businessId, email])
  @@index([businessId, phone])
}

model Identity {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  channel     Channel
  identifier  String
  displayName String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, channel, identifier])
  @@index([customerId])
}

model Conversation {
  id            String             @id @default(cuid())
  businessId    String
  customerId    String
  identityId    String?
  channel       Channel
  title         String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  lastOrderKey  String?            // fingerprint of the last items+address+payment combo that was actually ordered — blocks re-placing the same order on a repeat/duplicate AI trigger
  activeOrderId String?            // the order this conversation can still amend/cancel (cleared once it's no longer PENDING_PAYMENT)
  escalated        Boolean         @default(false) // true once the AI has paused itself/been paused for human handoff
  escalationReason String?
  outcome          ConversationOutcome @default(OPEN)
  // deterministic WhatsApp shopping flow (button/list taps) — separate from the free-text AI flow above
  shoppingState    ShoppingState   @default(IDLE)
  activeCategoryId String?         // category currently being browsed (BROWSING_PRODUCTS)
  activeProductId  String?         // product currently being viewed (VIEWING_PRODUCT / AWAITING_QUANTITY)
  pendingVariantId String?         // variant chosen while awaiting a quantity reply
  pendingAddress   String?         // shipping address collected mid-checkout, before payment method is chosen
  pendingPaymentMethod String?     // "UPI" | "COD" chosen mid-checkout, before final order confirmation
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  identity      Identity?          @relation(fields: [identityId], references: [id], onDelete: SetNull)
  messages      Message[]
  orders        Order[]
  carts         Cart[]

  @@index([businessId, status, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  content           String
  providerMessageId String?          @unique
  metadata          Json?            // { source, responseId, state, model } for AI drafts
  // sentAt: when the message was sent (caller-supplied for historical imports); createdAt: DB insert time
  sentAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model LeadScore {
  id         String   @id @default(cuid())
  customerId String   @unique
  score      Int      @default(0)
  reason     String?
  calculatedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  brand       String?
  imageUrl    String?
  status      ProductStatus @default(PUBLISHED)
  source      ProductSource @default(MANUAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    Variant[]
  orderItems  OrderItem[]

  @@index([businessId, status])
  @@index([categoryId])
}

// merchant-defined product grouping for category-first WhatsApp browsing (supports one level of subcategory via parentId)
model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryChildren")
  products   Product[]

  @@index([businessId, active, sortOrder])
  @@index([parentId])
}

// a sellable unit — every Product has at least one (the "default" variant for products without size/color options)
model Variant {
  id             String   @id @default(cuid())
  businessId     String
  productId      String
  sku            String?
  barcode        String?
  attributes     Json?    // e.g. { "size": "M", "color": "Red" } — null for single-variant products
  price          Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  inventory      Int?
  weight         Decimal? @db.Decimal(10, 3) // kg — captured now for future courier integration
  length         Decimal? @db.Decimal(10, 2) // cm
  width          Decimal? @db.Decimal(10, 2)
  height         Decimal? @db.Decimal(10, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([businessId, active])
  @@index([productId])
  @@unique([businessId, sku])
}

// carts driving the WhatsApp interactive shopping flow through to checkout — a conversation can have many
// over time (one per shopping session), but at most one ACTIVE cart per conversation (enforced in CartService)
model Cart {
  id             String     @id @default(cuid())
  businessId     String
  conversationId String
  customerId     String
  status         CartStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([businessId, status])
  @@index([conversationId, status])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// one uploaded catalogue file being parsed/validated/committed into products+variants
model ImportJob {
  id            String       @id @default(cuid())
  businessId    String
  filename      String
  sourceType    String       // "CSV" | "XLSX"
  status        ImportStatus @default(PENDING)
  rowsDetected  Int          @default(0)
  rowsReady     Int          @default(0)
  rowsWarning   Int          @default(0)
  rowsError     Int          @default(0)
  columnMapping Json?        // detected source-header -> canonical-field mapping, shown/confirmed on the review screen
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rows          ImportRow[]

  @@index([businessId, createdAt])
}

// one source row (e.g. one CSV line) within an ImportJob, tracked from raw data through to commit
model ImportRow {
  id               String          @id @default(cuid())
  importJobId      String
  rowNumber        Int
  rawData          Json            // original source fields, verbatim
  normalizedData   Json?           // mapped onto the canonical product schema
  status           ImportRowStatus @default(READY)
  validationErrors Json?           // string[]
  matchedProductId String?         // set when an existing SKU match was found
  action           String?         // "CREATE" | "UPDATE" | "SKIP" — merchant's resolution for this row, defaults based on validation
  committedProductId String?       // set once this row has been committed to a real Product
  createdAt        DateTime        @default(now())
  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, status])
}

model Order {
  id          String      @id @default(cuid())
  businessId  String
  customerId  String
  conversationId String?  // the conversation this order originated from, so the worker can notify the customer when payment clears
  status      OrderStatus @default(DRAFT)
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  subtotal    Decimal     @db.Decimal(12, 2)
  shippingFee Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("INR")
  shippingAddress Json?
  paymentMethod   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ActivityEvent {
  id          String            @id @default(cuid())
  businessId  String
  customerId  String?
  type        ActivityEventType
  summary     String
  metadata    Json?
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

// records every autonomous decision the AI makes that carries real-world consequence — the audit trail
// the merchant (and support) can use to see exactly what the AI did, why, and with what outcome
model AiActionLog {
  id             String   @id @default(cuid())
  businessId     String
  customerId     String?
  conversationId String?
  orderId        String?
  action         String
  reason         String?
  result         String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
