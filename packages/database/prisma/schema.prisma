generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMAIL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEB
  MANUAL
}

enum CustomerType {
  LEAD
  CUSTOMER
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum OrderStatus {
  DRAFT
  AWAITING_APPROVAL
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// tracks shipment progress independently of OrderStatus (payment/lifecycle) once an order is PAID
enum FulfillmentStatus {
  NOT_STARTED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// how a conversation ultimately resolved — for CRM/revenue reporting
enum ConversationOutcome {
  OPEN
  SALE
  SUPPORT
  ESCALATED
  LOST
  ABANDONED
}

enum ActivityEventType {
  CONVERSATION_CREATED
  MESSAGE_SENT
  ORDER_PLACED
  ORDER_UPDATED
  CUSTOMER_TAGGED
  LEAD_SCORED
}

model Business {
  id                    String         @id @default(cuid())
  name                  String
  industry              String?
  website               String?
  timezone              String         @default("Asia/Kolkata")
  whatsappPhoneNumberId String?        @unique
  instagramPageId       String?        @unique
  supportEmail          String?        @unique
  autonomyMaxOrderValue Decimal?       @db.Decimal(12, 2) // orders above this total require human approval before payment/fulfillment proceeds; null = no cap
  // per-merchant channel credentials, encrypted at rest (AES-256-GCM) — falls back to the shared .env tokens when null (single-demo-business setup)
  whatsappAccessTokenEncrypted String?
  instagramAccessTokenEncrypted String?
  postmarkServerTokenEncrypted   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  users         User[]
  customers     Customer[]
  identities    Identity[]
  conversations Conversation[]
  products      Product[]
  orders        Order[]
  activity      ActivityEvent[]
  aiActionLogs  AiActionLog[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  type          CustomerType   @default(LEAD)
  tags          String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities    Identity[]
  conversations Conversation[]
  leadScore     LeadScore?
  orders        Order[]
  activity      ActivityEvent[]

  @@index([businessId, updatedAt])
  @@unique([businessId, email])
  @@index([businessId, phone])
}

model Identity {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  channel     Channel
  identifier  String
  displayName String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, channel, identifier])
  @@index([customerId])
}

model Conversation {
  id            String             @id @default(cuid())
  businessId    String
  customerId    String
  identityId    String?
  channel       Channel
  title         String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  lastOrderKey  String?            // fingerprint of the last items+address+payment combo that was actually ordered — blocks re-placing the same order on a repeat/duplicate AI trigger
  activeOrderId String?            // the order this conversation can still amend/cancel (cleared once it's no longer PENDING_PAYMENT)
  escalated        Boolean         @default(false) // true once the AI has paused itself/been paused for human handoff
  escalationReason String?
  outcome          ConversationOutcome @default(OPEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  identity      Identity?          @relation(fields: [identityId], references: [id], onDelete: SetNull)
  messages      Message[]
  orders        Order[]

  @@index([businessId, status, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  content           String
  providerMessageId String?          @unique
  metadata          Json?            // { source, responseId, state, model } for AI drafts
  // sentAt: when the message was sent (caller-supplied for historical imports); createdAt: DB insert time
  sentAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model LeadScore {
  id         String   @id @default(cuid())
  customerId String   @unique
  score      Int      @default(0)
  reason     String?
  calculatedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  inventory   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([businessId, active])
}

model Order {
  id          String      @id @default(cuid())
  businessId  String
  customerId  String
  conversationId String?  // the conversation this order originated from, so the worker can notify the customer when payment clears
  status      OrderStatus @default(DRAFT)
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  subtotal    Decimal     @db.Decimal(12, 2)
  shippingFee Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("INR")
  shippingAddress Json?
  paymentMethod   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ActivityEvent {
  id          String            @id @default(cuid())
  businessId  String
  customerId  String?
  type        ActivityEventType
  summary     String
  metadata    Json?
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

// records every autonomous decision the AI makes that carries real-world consequence — the audit trail
// the merchant (and support) can use to see exactly what the AI did, why, and with what outcome
model AiActionLog {
  id             String   @id @default(cuid())
  businessId     String
  customerId     String?
  conversationId String?
  orderId        String?
  action         String
  reason         String?
  result         String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
