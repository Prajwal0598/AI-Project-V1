# Database and queues
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_customer_agent"
REDIS_URL="redis://localhost:6379"
PORT="4000"
WEB_ORIGIN="http://localhost:3000"
# public base URL the API is reachable at — used to build uploaded product image URLs (defaults to http://localhost:PORT)
API_PUBLIC_URL="http://localhost:4000"
# read by apps/web at BUILD time (Next.js inlines NEXT_PUBLIC_* vars into the client bundle) — the browser-facing API base URL
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# REQUIRED — the API refuses to start if this is missing or shorter than 32 characters. Never reuse this example value.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# AI model upgrade A/B experiment (apps/api/src/modules/ai) — all optional, safe to leave unset (experiment
# stays off, everything behaves exactly as before). See apps/api/src/modules/ai/README.md.
AI_MODEL_CONTROL=""            # defaults to OPENAI_MODEL above, then "gpt-4o"
AI_MODEL_EFFICIENT=""          # defaults to "gpt-5.6-luna"
AI_MODEL_BALANCED=""           # defaults to "gpt-5.6-terra"
AI_MODEL_ADVANCED=""           # defaults to "gpt-5.6-sol"
AI_MODEL_EXPERIMENT_ENABLED="false"
AI_MODEL_EXPERIMENT_TRAFFIC_PERCENT="0"
AI_MODEL_EXPERIMENT_ID="model-upgrade-v1"

# Add channel/payment credentials as each integration is enabled.
# WHATSAPP_APP_SECRET / INSTAGRAM_APP_SECRET — Meta App Dashboard "App Secret", used to verify the
# X-Hub-Signature-256 header on inbound webhooks. If left unset, signature verification is skipped in
# development but the webhook is REJECTED outright when NODE_ENV=production — must be set before going live.
WHATSAPP_APP_SECRET=""
INSTAGRAM_APP_SECRET=""
# Meta App ID — needed alongside WHATSAPP_APP_SECRET for the server-side WhatsApp Embedded Signup code
# exchange. Requires the app to have passed Meta App Review with Advanced Access before Embedded Signup works.
META_APP_ID=""
# Read by apps/web at BUILD time — the WhatsApp Embedded Signup configuration_id created in the Meta App
# Dashboard (WhatsApp > Embedded Signup). Not secret (used client-side by the Facebook JS SDK).
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=""
# Shared secret appended as ?secret= to the Postmark inbound webhook URL. Same skipped-in-dev/rejected-in-production behavior as above.
EMAIL_WEBHOOK_SECRET=""

# Razorpay — global fallback credentials, used only for a business that hasn't configured its own
# Key ID/Key Secret/Webhook Secret via the Settings page (per-business is preferred; see razorpayKeyId etc.
# on the Business model). Without either set, UPI orders use the simulated (fake) payment flow instead.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Razorpay OAuth (Technology Partner) — lets a merchant click "Connect Razorpay" and authorize on Razorpay's
# own site instead of pasting Key ID/Secret. Requires Relay to be an approved Razorpay Technology Partner
# first (see docs/app-overview.md) — these come from a Partner Application on the Razorpay Partner Dashboard,
# NOT a regular merchant account. If unset, the "Connect Razorpay" button in Settings will show an error and
# the manual Key ID/Secret fallback above still works.
RAZORPAY_OAUTH_CLIENT_ID=""
RAZORPAY_OAUTH_CLIENT_SECRET=""
# how often apps/worker refreshes OAuth-connected businesses' access tokens (see jobs/razorpay-token-refresh.ts)
RAZORPAY_TOKEN_REFRESH_CRON="0 4 * * *"

# 64-char hex string (32 bytes) used to encrypt per-merchant channel credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this set, per-business credentials can't be saved and every business shares the tokens above.
CREDENTIALS_ENCRYPTION_KEY=""

# Error monitoring (Sentry or a Sentry-compatible endpoint). Optional — if left unset, error reporting is a
# no-op everywhere (api, web, worker) and only the existing console/logger output is available.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# port the worker's health endpoint (GET /health) listens on — separate from the api's PORT above since both
# read from this same shared .env file in local development
WORKER_PORT="4001"

# Stopgap manual Postgres backups (apps/worker/src/jobs/database-backup.ts) until Railway Pro's automatic
# backups/PITR are enabled — requires the pg_dump client tool to be installed and on PATH.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
DATABASE_BACKUP_CRON="0 3 * * *"

# Orders stuck awaiting payment/approval past these windows are auto-cancelled and their stock released.
ORDER_PAYMENT_EXPIRY_MS=1800000
ORDER_APPROVAL_EXPIRY_MS=86400000

# A cart with items left untouched for this long (WhatsApp shopping flow) gets a one-time nudge message.
ABANDONED_CART_DELAY_MS=3600000
