# Database and queues
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_customer_agent"
REDIS_URL="redis://localhost:6379"
PORT="4000"
WEB_ORIGIN="http://localhost:3000"

# AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# Add channel/payment credentials as each integration is enabled.
# WHATSAPP_APP_SECRET / INSTAGRAM_APP_SECRET — Meta App Dashboard "App Secret", used to verify the
# X-Hub-Signature-256 header on inbound webhooks. If left unset, signature verification is skipped (dev only).
WHATSAPP_APP_SECRET=""
INSTAGRAM_APP_SECRET=""

# 64-char hex string (32 bytes) used to encrypt per-merchant channel credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this set, per-business credentials can't be saved and every business shares the tokens above.
CREDENTIALS_ENCRYPTION_KEY=""

# Orders stuck awaiting payment/approval past these windows are auto-cancelled and their stock released.
ORDER_PAYMENT_EXPIRY_MS=1800000
ORDER_APPROVAL_EXPIRY_MS=86400000
